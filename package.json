{
  "name": "phong-thi-nghiem-san-vuon",
  "version": "1.0.0",
  "private": true,
  "description": "Trang web 8 thi nghiem khoa hoc tuong tac cho hoc sinh tieu hoc. Mo bang cach nhay dup vao index.html, khong can cai dat gi.",
  "scripts": {
    "build": "npm run build:modern && npm run build:offline",
    "build:modern": "vite build --config vite.config.mts",
    "build:offline": "node tools/build-offline.mjs",
    "check:modern": "svelte-check-native --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:typescript": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "test": "node --test \"tests/*.test.js\"",
    "serve": "python3 tools/dev-server.py",
    "watch:modern": "vite build --config vite.config.mts --watch",
    "shots": "node tools/make-shots-page.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@sveltia/i18n": "1.5.0",
    "@threlte/core": "8.7.0",
    "@threlte/extras": "9.23.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "axe-core": "^4.14.1",
    "puppeteer-core": "^25.11.0",
    "svelte": "5.59.2",
    "svelte-check-native": "1.12.2",
    "three": "0.187.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  }
}
